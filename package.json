{
  "name": "ai-augmented-playwright-suite",
  "version": "1.0.0",
  "description": "LLM-augmented Playwright + TypeScript Page Object Model test framework: generates test specs from plain-English scenarios grounded in existing Page Objects, and auto-triages CI failures (flaky vs. real bug vs. selector drift) with structured JSON output.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\""
  },
  "keywords": [
    "playwright",
    "typescript",
    "page-object-model",
    "test-automation",
    "llm",
    "claude",
    "ci",
    "flaky-test-detection"
  ],
  "author": "Shruti Shrivastava",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
