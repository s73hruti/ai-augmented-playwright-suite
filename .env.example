# --- Claude API ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for spec generation and failure triage
ANTHROPIC_MODEL=claude-sonnet-4-5

# If set to "true" (or if ANTHROPIC_API_KEY is empty), the AI layer runs in
# deterministic mock mode instead of calling the real API. Useful for CI,
# demos, and offline development.
AI_MOCK_MODE=false

# --- Playwright target ---
BASE_URL=https://demo.playwright.dev/todomvc
LOCALE=en-US
MARKET=US

# --- Misc ---
LOG_LEVEL=info